# Leave NEXT_PUBLIC_API_URL empty for web (uses relative URLs)
NEXT_PUBLIC_API_URL=

# Multiplayer (PartyKit). Leave unset for local dev (uses localhost:1999 with `cd party && npx partykit dev`).
# Production builds without it hide multiplayer.
# NEXT_PUBLIC_PARTYKIT_HOST=edy-on-bike.<user>.partykit.dev

# Upstash Redis (for leaderboard + rate limiting in production)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
