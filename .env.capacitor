# Capacitor native build — loaded by `npm run build:mobile` (Next.js doesn't read this file itself).
# Points API calls to the hosted Vercel instance.
CAPACITOR_BUILD=1
NEXT_PUBLIC_API_URL=https://edyonbike.com
# Multiplayer server — required for multiplayer in the native app (hidden otherwise)
# NEXT_PUBLIC_MULTIPLAYER_HOST=edy-on-bike-multiplayer.<subdomain>.workers.dev
